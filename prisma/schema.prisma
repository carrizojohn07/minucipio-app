// Schema de la base de datos del Sistema de Gestión Municipal.
// Cubre los 4 módulos: Reclamos ciudadanos, Gestión de expedientes,
// Gestión de turnos y Atención al vecino.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Usuarios y roles ----------

enum Rol {
  VECINO
  EMPLEADO
  ADMIN
}

model Usuario {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  rol          Rol       @default(VECINO)
  creadoEn     DateTime  @default(now())

  vecino       Vecino?
  empleado     Empleado?
}

model Vecino {
  id         String   @id @default(cuid())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId  String   @unique
  nombre     String
  apellido   String
  dni        String   @unique
  telefono   String?
  direccion  String?

  reclamos   Reclamo[]
  expedientes Expediente[]
  turnos     Turno[]
  atenciones Atencion[]
}

// ---------- Áreas municipales ----------

model Area {
  id          String   @id @default(cuid())
  nombre      String   @unique // ej: "Obras Públicas", "Tránsito", "Salud"
  descripcion String?

  empleados    Empleado[]
  reclamos     Reclamo[]
  expedientes  Expediente[]
  turnos       Turno[]
}

model Empleado {
  id         String   @id @default(cuid())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId  String   @unique
  nombre     String
  apellido   String
  cargo      String?
  area       Area     @relation(fields: [areaId], references: [id])
  areaId     String

  turnosAsignados Turno[]
}

// ---------- Módulo: Reclamos ciudadanos ----------

enum EstadoReclamo {
  PENDIENTE
  EN_PROCESO
  RESUELTO
  RECHAZADO
}

model Reclamo {
  id           String        @id @default(cuid())
  titulo       String
  descripcion  String
  categoria    String        // ej: "Alumbrado", "Bacheo", "Recolección de residuos"
  estado       EstadoReclamo @default(PENDIENTE)
  prioridad    Int           @default(1) // 1 (baja) a 5 (urgente)
  direccion    String?
  respuesta    String?
  creadoEn     DateTime      @default(now())
  actualizadoEn DateTime     @updatedAt

  vecino    Vecino @relation(fields: [vecinoId], references: [id])
  vecinoId  String
  area      Area   @relation(fields: [areaId], references: [id])
  areaId    String
}

// ---------- Módulo: Gestión de expedientes ----------

enum EstadoExpediente {
  INICIADO
  EN_TRAMITE
  OBSERVADO
  CERRADO
}

model Expediente {
  id           String           @id @default(cuid())
  numero       String           @unique // ej: "EXP-2026-000123"
  caratula     String           // Título / Tema público (Ej: "Solicitud de Habilitación")
  extracto     String           // Resumen general público
  tipo         String           // ej: "Habilitación comercial", "Reclamo administrativo"
  estado       EstadoExpediente @default(INICIADO)
  esPrivado    Boolean          @default(false) // Indica si el expediente completo es confidencial
  fechaInicio  DateTime         @default(now())
  fechaCierre  DateTime?

  vecino       Vecino?          @relation(fields: [vecinoId], references: [id])
  vecinoId     String?
  area         Area             @relation(fields: [areaId], references: [id])
  areaId       String

  movimientos  MovimientoExpediente[]
}

model MovimientoExpediente {
  id             String           @id @default(cuid())
  expediente     Expediente       @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  expedienteId   String
  estadoNuevo    EstadoExpediente
  comentario     String?          // Observación o dictamen del pase
  esConfidencial Boolean          @default(false) // Si este movimiento solo lo ven Admin / Iniciador
  fecha          DateTime         @default(now())
}

// ---------- Módulo: Gestión de turnos ----------

enum EstadoTurno {
  RESERVADO
  CONFIRMADO
  CANCELADO
  ATENDIDO
}

model Turno {
  id          String      @id @default(cuid())
  fechaHora   DateTime
  servicio    String      // ej: "Licencia de conducir", "Consulta con asistente social"
  estado      EstadoTurno @default(RESERVADO)

  vecino      Vecino    @relation(fields: [vecinoId], references: [id])
  vecinoId    String
  area        Area      @relation(fields: [areaId], references: [id])
  areaId      String
  empleado    Empleado? @relation(fields: [empleadoId], references: [id])
  empleadoId  String?
}

// ---------- Módulo: Atención al vecino ----------

model Atencion {
  id          String   @id @default(cuid())
  motivo      String   // consulta general, no encuadrada en reclamo/turno/expediente
  descripcion String?
  fecha       DateTime @default(now())

  vecino    Vecino @relation(fields: [vecinoId], references: [id])
  vecinoId  String
}
